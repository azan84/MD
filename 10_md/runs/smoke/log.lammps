unfix           lang
unfix           nve0

# ---- 1b. equilibrate at target T,P -----------------------------------------
timestep        1.0
fix             nptrun all npt temp ${T} ${T} 100.0 iso ${Pbar} ${Pbar} 1000.0
fix             nptrun all npt temp 298.0 ${T} 100.0 iso ${Pbar} ${Pbar} 1000.0
fix             nptrun all npt temp 298.0 298.0 100.0 iso ${Pbar} ${Pbar} 1000.0
fix             nptrun all npt temp 298.0 298.0 100.0 iso 1.0 ${Pbar} 1000.0
fix             nptrun all npt temp 298.0 298.0 100.0 iso 1.0 1.0 1000.0
run             1500                       # 30 ps equilibration
