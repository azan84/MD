LAMMPS (22 Jul 2025 - Update 5)
  using 1 OpenMP thread(s) per MPI task
# ============================================================================
# MD-000-overhead : measure fix electrode/conp cost vs plain pppm (OI-1)
# Ni(111) | SPC/E water | Ni(111) parallel-slab cell
# Run twice: -var useconp 0  (baseline)  and  -var useconp 1  (constant potential)
# ============================================================================
variable        useconp index 0
units           real
atom_style      full
boundary        p p f
processors      * * 1

# ---- geometry (Angstrom) -----------------------------------------------------
variable        a       equal 3.524          # Ni fcc lattice constant
variable        lx      equal 8*${a}
variable        lx      equal 8*3.524
variable        ly      equal 8*${a}
variable        ly      equal 8*3.524
variable        zel     equal 3*${a}         # electrode slab thickness
variable        zel     equal 3*3.524         
variable        zwat    equal 60.0           # water gap
variable        ztot    equal 2*${zel}+${zwat}+20.0
variable        ztot    equal 2*10.572+${zwat}+20.0
variable        ztot    equal 2*10.572+60+20.0

lattice         fcc ${a}
lattice         fcc 3.524
Lattice spacing in x,y,z = 3.524 3.524 3.524
region          box block 0 ${lx} 0 ${ly} 0 ${ztot} units box
region          box block 0 28.192 0 ${ly} 0 ${ztot} units box
region          box block 0 28.192 0 28.192 0 ${ztot} units box
region          box block 0 28.192 0 28.192 0 101.144 units box
create_box      4 box                 bond/types 1 angle/types 1                 extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 2
Created orthogonal box = (0 0 0) to (28.192 28.192 101.144)
  4 by 4 by 1 MPI processor grid

# types: 1=Ow 2=Hw 3=Ni_bot(cathode) 4=Ni_top(anode)
mass            1 15.9994
mass            2 1.00794
mass            3 58.6934
mass            4 58.6934

region          rbot block INF INF INF INF 0.0 ${zel} units box
region          rbot block INF INF INF INF 0.0 10.572 units box
region          rtop block INF INF INF INF $(v_zel+v_zwat) $(2*v_zel+v_zwat) units box
region          rtop block INF INF INF INF 70.572000000000002728 $(2*v_zel+v_zwat) units box
region          rtop block INF INF INF INF 70.572000000000002728 81.144000000000005457 units box
lattice         fcc ${a} orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1
lattice         fcc 3.524 orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1
Lattice spacing in x,y,z = 4.9836886 5.7546679 6.103747
create_atoms    3 region rbot
Created 884 atoms
  using lattice units in orthogonal box = (0 0 0) to (28.192 28.192 101.144)
  create_atoms CPU = 0.010 seconds
create_atoms    4 region rtop
Created 770 atoms
  using lattice units in orthogonal box = (0 0 0) to (28.192 28.192 101.144)
  create_atoms CPU = 0.004 seconds

# ---- water ------------------------------------------------------------------
region          rwat block 2.0 $(v_lx-2.0) 2.0 $(v_ly-2.0) $(v_zel+3.0) $(v_zel+v_zwat-3.0) units box
region          rwat block 2.0 26.192000000000000171 2.0 $(v_ly-2.0) $(v_zel+3.0) $(v_zel+v_zwat-3.0) units box
region          rwat block 2.0 26.192000000000000171 2.0 26.192000000000000171 $(v_zel+3.0) $(v_zel+v_zwat-3.0) units box
region          rwat block 2.0 26.192000000000000171 2.0 26.192000000000000171 13.571999999999999176 $(v_zel+v_zwat-3.0) units box
region          rwat block 2.0 26.192000000000000171 2.0 26.192000000000000171 13.571999999999999176 67.572000000000002728 units box
molecule        h2o ${spce}
molecule        h2o spce.mol
Read molecule template h2o:
# SPC/E water molecule template
  1 molecules
  0 fragments
  0 bodies
  3 atoms with max type 2
  2 bonds with max type 1
  1 angles with max type 1
  0 dihedrals with max type 0
  0 impropers with max type 0
lattice         sc 3.5
Lattice spacing in x,y,z = 3.5 3.5 3.5
create_atoms    0 region rwat mol h2o 48577
Created 2352 atoms
  using lattice units in orthogonal box = (0 0 0) to (28.192 28.192 101.144)
  create_atoms CPU = 0.006 seconds

# ---- interactions ------------------------------------------------------------
pair_style      lj/cut/coul/long 10.0 10.0
pair_coeff      1 1 0.1553   3.166      # SPC/E O-O
pair_coeff      2 2 0.0      0.0
pair_coeff      1 2 0.0      0.0
pair_coeff      3 3 0.2075   2.4834     # Ni (Heinz UFF-derived)
pair_coeff      4 4 0.2075   2.4834
pair_coeff      1 3 0.1795   2.8247     # Ni-Ow (Lorentz-Berthelot)
pair_coeff      1 4 0.1795   2.8247
pair_coeff      2 3 0.0      0.0
pair_coeff      2 4 0.0      0.0
pair_coeff      3 4 0.2075   2.4834

bond_style      harmonic
bond_coeff      1 1000.0 1.0
angle_style     harmonic
angle_coeff     1 100.0 109.47

group           watr  type 1 2
2352 atoms in group watr
group           bot   type 3
884 atoms in group bot
group           top   type 4
770 atoms in group top
group           elec  union bot top
1654 atoms in group elec
set             group elec charge 0.0
Setting atom values ...
  1654 settings made for charge

if "${useconp} == 1" then   "kspace_style pppm/electrode 1.0e-4" else   "kspace_style pppm 1.0e-4"
kspace_style pppm/electrode 1.0e-4
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes exclude group elec elec

fix             shk watr shake 1.0e-4 100 0 b 1 a 1
Finding SHAKE clusters ...
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
     784 = # of frozen angles
  find clusters CPU = 0.004 seconds
velocity        watr create 333.0 48291 mom yes rot yes dist gaussian
fix             nvt watr nvt temp 333.0 333.0 100.0
fix             frz elec setforce 0.0 0.0 0.0

# ---- the measurement ---------------------------------------------------------
if "${useconp} == 1" then   "fix conp bot electrode/conp -1.0 1.805 couple top 1.0 symm on"   "print 'RUNMODE: CONSTANT POTENTIAL (fix electrode/conp)'" else   "print 'RUNMODE: BASELINE (no electrode solve)'"
fix conp bot electrode/conp -1.0 1.805 couple top 1.0 symm on
1654 atoms in group conp_group
print 'RUNMODE: CONSTANT POTENTIAL (fix electrode/conp)'
RUNMODE: CONSTANT POTENTIAL (fix electrode/conp)

timestep        1.0
thermo          20
thermo_style    custom step temp pe ke etotal press
run             200

