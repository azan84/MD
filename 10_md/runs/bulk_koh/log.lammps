Dangerous builds = vavariable        rho_mean equal f_davg
print           "RESULT density_g_cm3 ${rho_mean}"
RESULT density_g_cm3 1.26738478174561
unfix           davg
unfix           nptrun

# ---- 3. transport production (NVT at the equilibrated volume) ---------------
fix             nvtrun all nvt temp ${T} ${T} 100.0
fix             nvtrun all nvt temp 298.0 ${T} 100.0
fix             nvtrun all nvt temp 298.0 298.0 100.0
reset_timestep  0
compute         mw watr msd com yes
compute         mk kion msd com yes
compute         mo ohion msd com yes
fix             msdw all ave/time 10 1 10 c_mw[4] file msd_water_${tag}.dat
fix             msdw all ave/time 10 1 10 c_mw[4] file msd_water_koh30_s2_298.dat
fix             msdk all ave/time 10 1 10 c_mk[4] file msd_k_${tag}.dat
fix             msdk all ave/time 10 1 10 c_mk[4] file msd_k_koh30_s2_298.dat
fix             msdo all ave/time 10 1 10 c_mo[4] file msd_oh_${tag}.dat
fix             msdo all ave/time 10 1 10 c_mo[4] file msd_oh_koh30_s2_298.dat

# Green-Kubo inputs: off-diagonal pressure components
variable        pxy equal pxy
variable        pxz equal pxz
variable        pyz equal pyz
fix             pt all ave/time 1 1 1 v_pxy v_pxz v_pyz file press_${tag}.dat
fix             pt all ave/time 1 1 1 v_pxy v_pxz v_pyz file press_koh30_s2_298.dat

# trajectory for radial distribution functions (OI-16: previously no dumps were
# written, so the OH--water first-peak position could not be checked)
dump            trj all custom 5000 traj_${tag}.lammpstrj id type x y z
dump            trj all custom 5000 traj_koh30_s2_298.lammpstrj id type x y z
dump_modify     trj sort id

thermo          5000
run             200000                      # 200 ps production
