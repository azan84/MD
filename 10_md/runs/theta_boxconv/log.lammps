# ---- switch on constant potential -------------------------------------------
# psi is split symmetrically about zero so the cell voltage is dpsi
variable        half equal ${dpsi}/2.0
variable        half equal 0.0/2.0
fix             conp bot electrode/conp -${half} 1.805 couple top ${half} symm on
fix             conp bot electrode/conp -0 1.805 couple top ${half} symm on
fix             conp bot electrode/conp -0 1.805 couple top 0 symm on
3840 atoms in group conp_group
compute         qb bot property/atom q
compute         qt top property/atom q
compute         sqb bot reduce sum c_qb
compute         sqt top reduce sum c_qt
thermo_style    custom step c_tmob c_sqb c_sqt pe press
run             25000                      # 50 ps polarised equilibration

