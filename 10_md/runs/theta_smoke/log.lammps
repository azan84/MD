unfix           nve0
unfix           lang0

# ---- equilibrate at zero potential ------------------------------------------
timestep        2.0                        # SHAKE-constrained water; verified stable
fix             nvt mobile nvt temp ${T} ${T} 100.0
fix             nvt mobile nvt temp 333.0 ${T} 100.0
fix             nvt mobile nvt temp 333.0 333.0 100.0
run             1500                      # 50 ps
