# ---- production: density field for the contact angle ------------------------
reset_timestep  0
# 2D density map in the x-z plane, averaged over the periodic y (cylinder axis)
compute         cchunk liq chunk/atom bin/2d x lower 0.5 z lower 0.5 units box
fix             dmap liq ave/chunk 20 50 1000 cchunk density/mass                 file dens2d_${tag}.dat
fix             dmap liq ave/chunk 20 50 1000 cchunk density/mass                 file dens2d_v3.dat
compute         gchunk gas chunk/atom bin/2d x lower 0.5 z lower 0.5 units box
fix             gmap gas ave/chunk 20 50 1000 gchunk density/mass                 file gas2d_${tag}.dat
fix             gmap gas ave/chunk 20 50 1000 gchunk density/mass                 file gas2d_v3.dat
fix             qavg all ave/time 10 100 1000 c_sqb c_sqt file charge_${tag}.dat
fix             qavg all ave/time 10 100 1000 c_sqb c_sqt file charge_v3.dat

dump            trj all custom 20000 traj_${tag}.lammpstrj id type x y z
dump            trj all custom 20000 traj_v3.lammpstrj id type x y z
dump_modify     trj sort id

thermo          5000
run             3000                     # 1 ns production
