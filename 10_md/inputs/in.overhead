# ============================================================================
# MD-000-overhead : measure fix electrode/conp cost vs plain pppm (OI-1)
# Ni(111) | SPC/E water | Ni(111) parallel-slab cell
# Run twice: -var useconp 0  (baseline)  and  -var useconp 1  (constant potential)
# ============================================================================
variable        useconp index 0
units           real
atom_style      full
boundary        p p f
processors      * * 1

# ---- geometry (Angstrom) -----------------------------------------------------
variable        a       equal 3.524          # Ni fcc lattice constant
variable        lx      equal 8*${a}
variable        ly      equal 8*${a}
variable        zel     equal 3*${a}         # electrode slab thickness
variable        zwat    equal 60.0           # water gap
variable        ztot    equal 2*${zel}+${zwat}+20.0

lattice         fcc ${a}
region          box block 0 ${lx} 0 ${ly} 0 ${ztot} units box
create_box      4 box &
                bond/types 1 angle/types 1 &
                extra/bond/per/atom 2 extra/angle/per/atom 1 extra/special/per/atom 2

# types: 1=Ow 2=Hw 3=Ni_bot(cathode) 4=Ni_top(anode)
mass            1 15.9994
mass            2 1.00794
mass            3 58.6934
mass            4 58.6934

region          rbot block INF INF INF INF 0.0 ${zel} units box
region          rtop block INF INF INF INF $(v_zel+v_zwat) $(2*v_zel+v_zwat) units box
lattice         fcc ${a} orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1
create_atoms    3 region rbot
create_atoms    4 region rtop

# ---- water ------------------------------------------------------------------
region          rwat block 2.0 $(v_lx-2.0) 2.0 $(v_ly-2.0) $(v_zel+3.0) $(v_zel+v_zwat-3.0) units box
molecule        h2o ${spce}
lattice         sc 3.5
create_atoms    0 region rwat mol h2o 48577

# ---- interactions ------------------------------------------------------------
pair_style      lj/cut/coul/long 10.0 10.0
pair_coeff      1 1 0.1553   3.166      # SPC/E O-O
pair_coeff      2 2 0.0      0.0
pair_coeff      1 2 0.0      0.0
pair_coeff      3 3 0.2075   2.4834     # Ni (Heinz UFF-derived)
pair_coeff      4 4 0.2075   2.4834
pair_coeff      1 3 0.1795   2.8247     # Ni-Ow (Lorentz-Berthelot)
pair_coeff      1 4 0.1795   2.8247
pair_coeff      2 3 0.0      0.0
pair_coeff      2 4 0.0      0.0
pair_coeff      3 4 0.2075   2.4834

bond_style      harmonic
bond_coeff      1 1000.0 1.0
angle_style     harmonic
angle_coeff     1 100.0 109.47

group           watr  type 1 2
group           bot   type 3
group           top   type 4
group           elec  union bot top
set             group elec charge 0.0

if "${useconp} == 1" then &
  "kspace_style pppm/electrode 1.0e-4" &
else &
  "kspace_style pppm 1.0e-4"
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes exclude group elec elec

fix             shk watr shake 1.0e-4 100 0 b 1 a 1
velocity        watr create 333.0 48291 mom yes rot yes dist gaussian
fix             nvt watr nvt temp 333.0 333.0 100.0
fix             frz elec setforce 0.0 0.0 0.0

# ---- the measurement ---------------------------------------------------------
if "${useconp} == 1" then &
  "fix conp bot electrode/conp -1.0 1.805 couple top 1.0 symm on" &
  "print 'RUNMODE: CONSTANT POTENTIAL (fix electrode/conp)'" &
else &
  "print 'RUNMODE: BASELINE (no electrode solve)'"

timestep        1.0
thermo          20
thermo_style    custom step temp pe ke etotal press
run             200
print           "ATOMS_TOTAL: $(count(all))  WATER: $(count(watr))  ELECTRODE: $(count(elec))"
